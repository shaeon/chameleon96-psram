			memory_oct_rzqin                       : in    std_logic                      := 'X';             -- oct_rzqin
			pio_rf_leds_external_connection_export : out   std_logic_vector(1 downto 0);                      -- export
			reset_bridge_0_out_reset_1_reset       : out   std_logic                                          -- reset
		);
	end component hps;

